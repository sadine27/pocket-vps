# T3 project — copy to .env and fill in real values. Never commit the filled-in .env.

# ── SSH (phone server access) ──────────────────────────────────────────────
SSH_HOST=192.168.1.xxx
SSH_PORT=8022
SSH_USER=your-username
SSH_KEY_PATH=/path/to/ssh/key
SSH_LEGACY_PASSWORD=

# ── Telegram bot ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_ID=
TELEGRAM_APPROVER_HANDLE=

# ── DuckDNS ──────────────────────────────────────────────────────────────
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# ── n8n (phone instance) ───────────────────────────────────────────────────
N8N_URL=
N8N_API_KEY=

# ── n8n CLOUD (separate instance, e.g. Google automation / MCP) ─────────────
N8N_CLOUD_URL=
N8N_CLOUD_API_KEY=
N8N_CLOUD_INSTANCE_MCP_URL=

# ── GCP ──────────────────────────────────────────────────────────────────
GCP_PLACES_API_KEY=
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=

# ── TLS / ACME ───────────────────────────────────────────────────────────
# Cert/key files are NOT env vars — see .gitignore. Only the account email goes here.
ACME_ACCOUNT_EMAIL=
